{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Task Manager",
  "version": "0.83.0",
  "identifier": "org.opentaskmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Task Manager",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "A free, open source task manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "lm-sensors",
          "smartmontools",
          "pkexec",
          "xdg-utils",
          "curl"
        ]
      },
      "rpm": {
        "recommends": [
          "(lm_sensors or sensors)",
          "smartmontools",
          "xdg-utils",
          "curl"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MTc0MjE0NTEyRDFBMkUKUldRdUdpMVJGRUlYZEZWNnU4cE9reDZscnpHYStTV0VRaFBpc2g3cy8zZkF4NnF1N3R5bUpCOHQK",
      "endpoints": [
        "https://github.com/RJCogburn/open-task-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
